# ── COPY THIS FILE ────────────────────────────────────────────────────────────
# cp .env.example .env
# Fill every value. NEVER commit .env to git.

# ── DEPLOYER (testnet only to start) ─────────────────────────────────────────
DEPLOYER_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# ── SERVER HOT WALLET (signs settlements) ────────────────────────────────────
OPERATOR_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY
OPERATOR_SIGNER=0xYOUR_OPERATOR_WALLET_ADDRESS

# ── REVENUE & ORACLE WALLETS ─────────────────────────────────────────────────
RAKE_WALLET=0xYOUR_RAKE_RECIPIENT_ADDRESS        # personal income: 20% of rake + seat fees
ANTIBOT_ORACLE=0xYOUR_ORACLE_WALLET_ADDRESS

# ── TOKEN DISTRIBUTION WALLETS ───────────────────────────────────────────────
DEV_WALLET=0xYOUR_DEV_WALLET                     # 100M CHIPS vested 24 months (personal equity)
OPS_WALLET=0xYOUR_OPS_WALLET                     # 100M CHIPS devops budget (servers/staff/marketing)
COMMUNITY_WALLET=0xYOUR_COMMUNITY_WALLET         # 100M CHIPS (tournaments, airdrops, grants)
LIQUIDITY_WALLET=0xYOUR_LIQUIDITY_WALLET         # 500M CHIPS (DEX liquidity pools)

# ── RPC ENDPOINTS (get from alchemy.com) ─────────────────────────────────────
ARB_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
ARB_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── API KEYS ──────────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY
GITCOIN_PASSPORT_API=YOUR_PASSPORT_KEY
GITCOIN_SCORER_ID=YOUR_SCORER_ID
ARBISCAN_API_KEY=YOUR_ARBISCAN_KEY

# ── GAME SERVER FLAGS ─────────────────────────────────────────────────────────
# Set to true on testnet to skip Gitcoin + activity checks; operator marks users as human directly
TESTNET_SKIP_HUMAN_CHECK=false
# Opt-in secret for the /api/verify dev escape hatch (manual curl testing only). Leave unset to disable the route entirely.
DEV_VERIFY_SECRET=
# Sponsored (gasless) cashouts: the operator wallet submits PokerEscrow.cashOut() so players
# withdraw winnings without paying gas or signing. On by default; set to false to make players
# self-submit. Auto-pauses when the operator wallet drops below MIN_OPERATOR_ETH.
SPONSOR_CASHOUT=true
FRONTEND_ORIGIN=https://pokervsplayer.xyz                # WS server CORS allow-origin (everything except the public /tables endpoint)

# ── FRONTEND (safe to expose — NEXT_PUBLIC_ prefix) ──────────────────────────
NEXT_PUBLIC_APP_URL=https://pokervsplayer.xyz             # canonical URL for OG image + Farcaster Mini App manifest/frame
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
NEXT_PUBLIC_TRANSAK_API_KEY=                             # free staging key from transak.com/developers — public widget key, not a secret. Leave blank to disable the /buy card tab
NEXT_PUBLIC_TRANSAK_ENV=STAGING                           # 'STAGING' or 'PRODUCTION' — picks which Transak widget domain to load
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_WS_URL=wss://your-game-server.railway.app

# ── CONTRACT ADDRESSES (filled after deploy) ─────────────────────────────────
NEXT_PUBLIC_CHIPS_TOKEN=
NEXT_PUBLIC_ESCROW=
NEXT_PUBLIC_STAKING=
NEXT_PUBLIC_REFERRAL=
NEXT_PUBLIC_TOURNAMENT=
NEXT_PUBLIC_TABLE_REGISTRY=
NEXT_PUBLIC_POKER_HANDLE=
