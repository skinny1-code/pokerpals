{
  "name": "saloon",
  "version": "1.0.0",
  "description": "Saloon \u2014 Onchain PvP Crypto Poker Network",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "NODE_ENV=production next build",
    "build:check": "next build --debug-prerender",
    "start": "next start",
    "server": "node --env-file=.env server/index.js",
    "oracle": "node --env-file=.env server/antiBotOracle.js",
    "compile": "npx hardhat compile",
    "deploy:testnet": "npx hardhat run scripts/deploy.js",
    "deploy:handle": "npx hardhat run scripts/deployHandle.js",
    "deploy:escrow": "npx hardhat run scripts/redeploy-escrow.js",
    "deploy:tournament": "npx hardhat run scripts/redeploy-tournament.js",
    "deploy:mainnet": "DEPLOY_NETWORK=robinhood npx hardhat run scripts/deploy.js",
    "deploy:arbitrum-one": "DEPLOY_NETWORK=arbitrum npx hardhat run scripts/deploy.js",
    "deploy:robinhood-testnet": "DEPLOY_NETWORK=robinhoodTestnet npx hardhat run scripts/deploy.js",
    "deploy:robinhood": "DEPLOY_NETWORK=robinhood npx hardhat run scripts/deploy.js",
    "test": "node test/holdem.test.mjs && node test/botBrain.test.mjs && node test/ambientEngine.test.mjs && node test/cashoutRelay.test.mjs && node test/appUrl.test.mjs && node test/dashboardEconomics.test.mjs && node test/encryptEnv.test.mjs",
    "test:contracts": "npx hardhat test",
    "setup:wallets": "node scripts/generateWallets.js",
    "setup:env": "node scripts/setupEnv.js",
    "faucet": "node scripts/faucet.js",
    "fix:antibot-oracle": "node scripts/fixAntiBotOracle.js",
    "launch": "npm run server & npm run dev",
    "setup:profit-split": "node scripts/setupProfitSplit.js",
    "distribute-profits": "node scripts/distributeProfits.js",
    "redeploy:handle": "node scripts/redeployHandle.js",
    "deploy:lottery": "node scripts/deployLottery.js",
    "lottery:draw": "node scripts/lotteryDraw.js",
    "fund:rakeback": "node scripts/fundRakeback.js",
    "encrypt:env": "node scripts/encryptEnv.js",
    "sync:artifacts": "node scripts/syncArtifacts.js",
    "transfer:ownership": "node scripts/transferOwnership.js",
    "slither": "node scripts/slitherCheck.js"
  },
  "dependencies": {
    "@farcaster/miniapp-sdk": "^0.3.0",
    "@farcaster/miniapp-wagmi-connector": "^2.0.0",
    "@neynar/react": "^1.2.22",
    "@openzeppelin/contracts": "^5.6.1",
    "@pigment-css/react": "^0.0.31",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "ethers": "^6.16.0",
    "next": "^16.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.52.2",
    "wagmi": "^3.6.21",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "@nomicfoundation/hardhat-mocha": "^3.0.21",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "hardhat": "^3.16.0",
    "mocha": "^11.7.6",
    "solc": "^0.8.35",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "axios": "^1.18.1",
    "baseline-browser-mapping": "^2.11.21",
    "brace-expansion": "^2.1.4",
    "browserslist": "^4.28.9",
    "diff": "^8.0.4",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.25",
    "serialize-javascript": "^7.0.6",
    "sharp": "^0.35.4",
    "stream-json": "^3.6.0",
    "tmp": "^0.2.7",
    "undici": "^6.28.1",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  }
}
