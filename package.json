{
  "name": "pokerpals",
  "version": "1.0.0",
  "description": "PokerPartyPals — Onchain PvP Crypto Poker Network",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server": "node --env-file=.env server/index.js",
    "oracle": "node --env-file=.env server/antiBotOracle.js",
    "compile": "npx hardhat compile",
    "deploy:testnet": "npx hardhat run scripts/deploy.js --network arbitrumSepolia",
    "deploy:mainnet": "npx hardhat run scripts/deploy.js --network arbitrum",
    "test": "npx hardhat test",
    "setup:wallets": "node scripts/generateWallets.js",
    "setup:env": "node scripts/setupEnv.js",
    "faucet": "npx hardhat run scripts/faucet.js --network arbitrumSepolia"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "wagmi": "^2.12.0",
    "viem": "^2.17.0",
    "@tanstack/react-query": "^5.51.0",
    "ws": "^8.18.0",
    "ethers": "^6.13.0",
    "node-fetch": "^3.3.2",
    "@openzeppelin/contracts": "^5.0.0"
  },
  "devDependencies": {
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "dotenv": "^16.4.0"
  }
}
